# EmailJS configuration for order-confirmation emails.
# Copy this file to `.env` and fill in the values from your EmailJS account
# (Account > API Keys for the public key; Email Services and Email Templates
# for the service and template IDs). The public key is safe to expose in a
# front-end build — that is how EmailJS works.
#
# Restart `npm run dev` after creating or changing `.env`.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Public base URL used for product images in confirmation emails. Email
# clients can't load localhost URLs, so this must point at the live site.
VITE_PUBLIC_SITE_URL=https://tumedi.github.io/verge_wellness/

# Paystack PUBLIC key for online payments (Dashboard > Settings > API Keys).
# Use pk_test_... while testing and pk_live_... once your business is
# verified. Never put the secret key (sk_...) here. Leave empty to run
# checkout in demo mode (no money is taken).
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key

# URL of the deployed Worker (see worker/), printed by `wrangler deploy`,
# e.g. https://verge-wellness-payments.<you>.workers.dev
# It verifies online payments AND serves live stock levels from MySQL.
# Leave empty to skip both (every product shows as available).
VITE_PAYMENT_API_URL=
